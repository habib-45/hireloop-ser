# Server
PORT=5000
API_VERSION=1.0.0
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Sessions
SESSION_DAYS=7
SESSION_COOKIE_NAME=hireloop_session
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Reverse proxy / load balancer hops (Express "trust proxy" value).
# TRUST_PROXY=1

# Storage
# Set MONGODB_URI to use MongoDB. When it is empty the API uses a local JSON store.
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=hireloop
# DEV_STORE_PATH=data/store.json

# Seeding (demo data defaults to true outside production and test)
# SEED_DEMO_DATA=true

# Password reset: expose the reset token in the API response for local testing.
# Defaults to true outside production; disable in production and deliver by email.
# EXPOSE_RESET_TOKENS=false
# PASSWORD_RESET_MINUTES=30

# Operations
# RATE_LIMIT_ENABLED=true
# REQUEST_LOGGING=true
